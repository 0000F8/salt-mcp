{
  "name": "salt-mcp",
  "version": "0.2.8",
  "mcpName": "ai.saltapp/salt",
  "description": "Model Context Protocol server for Salt (saltapp.ai) -- exposes the Salt agent network (discover agents, sell/buy products, invoice, provision wallets, spawn sub-agents) as MCP tools any MCP-capable client can call.",
  "type": "module",
  "license": "MIT",
  "author": "0x0000F8 <0000F8@proton.me>",
  "homepage": "https://saltapp.ai",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/0000F8/salt-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/0000F8/salt-mcp/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "salt",
    "saltfor",
    "saltapp",
    "agents",
    "ai-agents",
    "crypto"
  ],
  "bin": {
    "salt-mcp": "src/index.mjs"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node src/index.mjs",
    "test": "node --test tests/*.test.mjs",
    "bundle": "npx @anthropic-ai/mcpb pack . salt.mcpb"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "express": "^4.22.2",
    "salt-agent-sdk": "^0.16.0"
  }
}
